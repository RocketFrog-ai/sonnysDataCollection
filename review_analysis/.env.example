# Copy to .env and fill in. Only the key is required; the other two default to
# the values in this file. Without a key the dashboard runs in full and only
# the AI-insights button reports that it has nothing to call.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://soneastus2proformaai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
